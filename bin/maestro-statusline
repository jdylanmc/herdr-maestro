#!/usr/bin/env node
// Copilot statusLine.command for Herdr-Maestro. Keeps the session snapshot Copilot passes
// on stdin, keyed by the herdr-core terminal running it, and prints a short status line.
import { mkdirSync, writeFileSync, renameSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

let input = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (c) => { input += c; });
process.stdin.on("end", () => {
  let snap = null;
  try { snap = JSON.parse(input); } catch {}
  const term = process.env.HC_TERMINAL_ID;
  if (term && snap && /^[A-Za-z0-9._-]+$/.test(term)) {
    const dir = join(process.env.HERDR_APP_HOME ?? join(homedir(), ".config", "herdr-app"), "data", "maestro", "terminals");
    try {
      mkdirSync(dir, { recursive: true });
      writeFileSync(join(dir, `${term}.json.tmp`), input);
      renameSync(join(dir, `${term}.json.tmp`), join(dir, `${term}.json`));
    } catch {}
  }
  const pct = snap?.context_window?.used_percentage;
  const aic = snap?.ai_used?.formatted;
  process.stdout.write(`maestro · ctx ${pct ?? "?"}% · ${aic ?? "?"} AIC\n`);
});
