#!/usr/bin/env node
// Herdr-Maestro agent CLI. Lets a Copilot session running in a Herdr terminal see its
// peers, message them, launch and close visible workers, notify the human, and set its
// own tags and mood. Everything goes through herdr-core (`hc`) and the Herdr app
// (`herdr-app do`); Maestro's mod reads the files written under data/maestro/.

import { execFileSync } from "node:child_process";
import { mkdirSync, readFileSync, writeFileSync, renameSync, existsSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join } from "node:path";

const HOME = process.env.HERDR_APP_HOME ?? join(homedir(), ".config", "herdr-app");
const DATA = join(HOME, "data", "maestro");
const AGENTS = join(DATA, "agents");
const NOTIFY = join(DATA, "notify");
const ME = process.env.HC_TERMINAL_ID ?? null;
const MOODS = ["happy", "focused", "thinking", "proud", "confused", "stuck", "sleepy", "celebrating"];
const DEFAULT_ARGV = ["copilot", "--yolo"];
const WORKTREES = join(DATA, "worktrees.json");
const worktrees = () => (existsSync(WORKTREES) ? JSON.parse(readFileSync(WORKTREES, "utf8")) : {});
const git = (cwd, args) => run("git", ["-C", cwd, ...args]).trim();

// A sibling checkout: <parent of repo>/<repo>-<branch>, on a new branch from HEAD.
function makeWorktree(from, branch, owner) {
  const top = git(from, ["rev-parse", "--show-toplevel"]);
  const path = join(dirname(top), `${basename(top)}-${branch.replace(/[^A-Za-z0-9._-]+/g, "-")}`);
  if (existsSync(path)) fail(`${path} already exists`);
  const exists = run("git", ["-C", top, "branch", "--list", branch]).trim();
  git(top, ["worktree", "add", ...(exists ? [path, branch] : ["-b", branch, path])]);
  writeJson(WORKTREES, { ...worktrees(), [path]: { repo: top, branch, owner, created: Date.now() } });
  return path;
}

const out = (v) => process.stdout.write(typeof v === "string" ? v + "\n" : JSON.stringify(v, null, 2) + "\n");
function fail(msg, code = 1) { process.stderr.write(`maestro: ${msg}\n`); process.exit(code); }
const run = (cmd, args) => execFileSync(cmd, args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
const json = (cmd, args) => JSON.parse(run(cmd, args));

function writeJson(path, value) {
  mkdirSync(join(path, ".."), { recursive: true });
  writeFileSync(path + ".tmp", JSON.stringify(value, null, 1));
  renameSync(path + ".tmp", path);
}
const recordOf = (t) => {
  const p = join(AGENTS, `${t}.json`);
  return existsSync(p) ? JSON.parse(readFileSync(p, "utf8")) : {};
};
const saveRecord = (t, patch) => writeJson(join(AGENTS, `${t}.json`), { ...recordOf(t), ...patch, updated: Date.now() });

function needMe() {
  if (!ME) fail("not inside a Herdr terminal (HC_TERMINAL_ID is unset)");
  return ME;
}

// Herdr's view: which space and tab each terminal is in, plus core state.
function world() {
  const app = json("herdr-app", ["ls"]);
  const where = new Map();
  for (const s of app.spaces ?? []) for (const tab of s.tabs ?? []) for (const term of tab.terminals ?? []) {
    where.set(term.terminal, { space: s.id, space_name: s.name, tab: tab.id, tab_name: tab.name, status: term.status ?? null, app: term.app ?? null });
  }
  // `hc ls` omits labels, which carry Maestro's lineage; read each terminal in full.
  const core = (json("hc", ["ls", "--json"]).terminals ?? []).map((t) => { try { return { ...t, ...json("hc", ["get", t.address, "--json"]) }; } catch { return t; } });
  return core.map((t) => {
    const w = where.get(t.address) ?? (t.parent ? where.get(t.parent) : null) ?? {};
    const rec = recordOf(t.address);
    const lab = t.labels ?? {};
    return { address: t.address, name: rec.name ?? lab["maestro.name"] ?? t.name ?? null, agent: t.agent ?? null, status: (typeof t.status === "object" ? t.status?.state : t.status) ?? w.status ?? null, cwd: t.cwd, space: w.space ?? null, space_name: w.space_name ?? null, tab_name: w.tab_name ?? null, parent: rec.parent ?? lab["maestro.parent"] ?? t.parent ?? null, tags: rec.tags ?? [], mood: rec.mood ?? null };
  });
}

const descendants = (all, root) => {
  const kids = new Set();
  let grew = true;
  while (grew) {
    grew = false;
    for (const t of all) if ((t.parent === root || kids.has(t.parent)) && !kids.has(t.address)) { kids.add(t.address); grew = true; }
  }
  return kids;
};

const commands = {
  whoami() {
    const me = needMe();
    const self = world().find((t) => t.address === me);
    out(self ?? { address: me });
  },

  peers(args) {
    const me = needMe();
    const all = world();
    const self = all.find((t) => t.address === me);
    const scope = args.includes("--all") ? all : all.filter((t) => t.space && t.space === self?.space);
    out(scope.filter((t) => t.address !== me && t.agent).map(({ address, name, agent, status, space_name, tab_name, parent, tags, mood }) => ({ address, name, agent, status, space: space_name, tab: tab_name, parent, tags, mood })));
  },

  send([to, ...words]) {
    let target = to;
    const me = needMe();
    if (!target || !words.length) fail("usage: maestro send <terminal> <message>");
    const text = words.join(" ");
    const name = recordOf(me).name ?? me;
    const hit = world().find((t) => t.address === target || t.name === target);
    if (hit) target = hit.address;
    run("hc", ["send", target, `[maestro from ${me}${name !== me ? ` ${name}` : ""}] ${text}`]);
    out({ sent: true, to: target });
  },

  spawn(args) {
    const me = needMe();
    const opt = { name: null, cwd: process.cwd(), task: null, argv: null };
    for (let i = 0; i < args.length; i++) {
      const a = args[i];
      if (a === "--name") opt.name = args[++i];
      else if (a === "--cwd") opt.cwd = args[++i];
      else if (a === "--task") opt.task = args[++i];
      else if (a === "--worktree") opt.worktree = args[++i];
      else if (a === "--") { opt.argv = args.slice(i + 1); break; }
      else if (!opt.task) opt.task = a;
    }
    if (opt.worktree) opt.cwd = makeWorktree(opt.cwd, opt.worktree, me);
    const self = world().find((t) => t.address === me);
    const argv = opt.argv?.length ? opt.argv : [...DEFAULT_ARGV, ...(opt.task ? ["-i", opt.task] : [])];
    const req = { ...(self?.space ? { space: self.space } : {}), folder: opt.cwd, argv, ...(opt.name ? { name: opt.name } : {}) };
    const made = JSON.parse(run("herdr-app", ["do", "tab.new", JSON.stringify(req)]));
    if (made.error || !made.terminal) fail(`tab.new failed: ${made.error ?? "no terminal"}`);
    try { run("hc", ["label", made.terminal, `maestro.parent=${me}`, ...(opt.name ? [`maestro.name=${opt.name}`] : [])]); } catch {}
    saveRecord(made.terminal, { parent: me, name: opt.name ?? null, launched: Date.now(), launcher: me, worktree: opt.worktree ? opt.cwd : null });
    if (opt.worktree) writeJson(WORKTREES, { ...worktrees(), [opt.cwd]: { ...worktrees()[opt.cwd], terminal: made.terminal } });
    out({ address: made.terminal, tab: made.tab, space: made.space, parent: me, ...(opt.worktree ? { worktree: opt.cwd } : {}) });
  },

  close([target]) {
    const me = needMe();
    if (!target) fail("usage: maestro close <terminal>");
    const all = world();
    const t = all.find((x) => x.address === target || x.name === target);
    if (!t) fail(`no live terminal ${target}`);
    if (!descendants(all, me).has(t.address)) fail(`denied: ${t.address} was not launched by ${me} or its workers`, 3);
    run("herdr-app", ["do", "terminal.kill", JSON.stringify({ terminal: t.address })]);
    out({ closed: t.address });
  },

  notify([title, ...body]) {
    const me = needMe();
    if (!title) fail("usage: maestro notify <title> [body]");
    const id = `${Date.now()}-${me}`;
    writeJson(join(NOTIFY, `${id}.json`), { from: me, title, body: body.join(" ") || null, at: Date.now() });
    out({ queued: id });
  },

  tag([op, ...tags]) {
    const me = needMe();
    const cur = new Set(recordOf(me).tags ?? []);
    if (op === "add") tags.forEach((x) => cur.add(x.toLowerCase()));
    else if (op === "rm") tags.forEach((x) => cur.delete(x.toLowerCase()));
    else if (op === "set") { cur.clear(); tags.forEach((x) => cur.add(x.toLowerCase())); }
    else if (op !== "ls") fail("usage: maestro tag add|rm|set|ls [tags...]");
    if (op !== "ls") saveRecord(me, { tags: [...cur].slice(0, 8) });
    out([...cur]);
  },

  mood([m]) {
    const me = needMe();
    if (!m) { out({ mood: recordOf(me).mood ?? null, choices: MOODS }); return; }
    if (m === "clear") { saveRecord(me, { mood: null }); out({ mood: null }); return; }
    if (!MOODS.includes(m)) fail(`mood must be one of: ${MOODS.join(", ")}`);
    saveRecord(me, { mood: m, mood_at: Date.now() });
    out({ mood: m });
  },

  // Worktrees Maestro created: list them, or remove one when it is clean and its worker is gone.
  worktree([op, target, ...flags]) {
    const all = worktrees();
    if (!op || op === "ls") {
      const live = new Set(json("hc", ["ls", "--json"]).terminals?.map((t) => t.address) ?? []);
      out(Object.entries(all).map(([path, w]) => ({ path, branch: w.branch, owner: w.owner, terminal: w.terminal ?? null, live: w.terminal ? live.has(w.terminal) : false })));
      return;
    }
    if (op !== "rm" || !target) fail("usage: maestro worktree ls | rm <path|branch> [--force]");
    const entry = Object.entries(all).find(([p, w]) => p === target || w.branch === target);
    if (!entry) fail(`${target} is not a worktree Maestro created`, 3);
    const [path, w] = entry;
    const live = new Set(json("hc", ["ls", "--json"]).terminals?.map((t) => t.address) ?? []);
    if (w.terminal && live.has(w.terminal)) fail(`denied: its worker ${w.terminal} is still running`, 3);
    if (existsSync(path)) {
      const dirty = git(path, ["status", "--porcelain"]);
      if (dirty && !flags.includes("--force")) fail(`denied: ${path} has uncommitted changes (use --force)`, 3);
      git(w.repo, ["worktree", "remove", ...(flags.includes("--force") ? ["--force"] : []), path]);
    }
    const next = { ...all };
    delete next[path];
    writeJson(WORKTREES, next);
    out({ removed: path, branch: w.branch, note: "branch kept" });
  },

  name([n]) {
    const me = needMe();
    saveRecord(me, { name: n ?? null });
    out({ name: n ?? null });
  },

  help() {
    out(`maestro — coordinate Copilot agents in Herdr

  maestro whoami                       this terminal, its space, parent, tags, mood
  maestro peers [--all]                agents in this space (or everywhere)
  maestro send <t> <message>           message another agent (fire and forget)
  maestro spawn [--name n] [--cwd d] [--task text | -- argv...]
                                       open a visible Copilot worker in a new tab of this space
                 [--worktree <branch>]  … in a new sibling worktree <repo>-<branch>
  maestro close <t>                    close a worker this agent (or its workers) launched
  maestro worktree ls | rm <path|branch> [--force]
                                       worktrees Maestro created; rm only when clean and unattended
  maestro notify <title> [body]        show the human a Herdr toast that jumps here
  maestro tag add|rm|set|ls [tags]     this agent's own tags
  maestro mood <${MOODS.join("|")}|clear>
  maestro name <short name>            label shown in Maestro`);
  },
};

const [cmd = "help", ...rest] = process.argv.slice(2);
const fn = commands[cmd] ?? commands[cmd.replace(/^--?/, "")];
if (!fn) fail(`unknown command ${cmd}; see maestro help`);
try { fn(rest); } catch (e) { fail(e.stderr?.toString().trim() || e.message); }
