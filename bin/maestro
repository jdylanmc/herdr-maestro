#!/usr/bin/env node
// Herdr-Maestro agent CLI. Lets a Copilot session running in a Herdr terminal see its
// peers, message them, launch and close visible workers, notify the human, and set its
// own tags and mood. Everything goes through herdr-core (`hc`) and the Herdr app
// (`herdr-app do`); Maestro's mod reads the files written under data/maestro/.

import { execFile, execFileSync } from "node:child_process";
import { mkdirSync, readFileSync, writeFileSync, renameSync, existsSync, copyFileSync, rmSync, symlinkSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join, resolve } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { realpathSync } from "node:fs";

const MOD = join(dirname(realpathSync(fileURLToPath(import.meta.url))), "..", "mods", "maestro");
const HELPER = join(MOD, "helper.mjs");
const pets = await import(pathToFileURL(join(MOD, "petlib.js")).href);
const wt = await import(pathToFileURL(join(MOD, "wtlib.js")).href);
const agentlib = await import(pathToFileURL(join(MOD, "agentlib.js")).href);

const HOME = process.env.HERDR_APP_HOME ?? join(homedir(), ".config", "herdr-app");
const DATA = join(HOME, "data", "maestro");
const AGENTS = join(DATA, "agents");
const NOTIFY = join(DATA, "notify");
const ME = process.env.HC_TERMINAL_ID ?? null;
const ICON_PRESETS = ["robot", "code", "bug", "eye", "shield", "compass", "brush", "flask", "rocket", "cogs", "search", "book", "terminal", "wrench", "lightbulb", "heart", "star", "bolt"];
const MOODS = ["happy", "focused", "thinking", "proud", "confused", "stuck", "sleepy", "celebrating"];
const DEFAULT_ARGV = agentlib.DEFAULT_ARGV;
const WORKTREES = join(DATA, "worktrees.json");
const PETS = join(DATA, "pets");
const CHOICES = join(PETS, "choices.json");
const PET_SOURCES = join(DATA, "pet-sources");
const petIndex = () => { try { return JSON.parse(readFileSync(join(PETS, "index.json"), "utf8")); } catch { return []; } };
const choices = () => pets.parseChoices(existsSync(CHOICES) ? readFileSync(CHOICES, "utf8") : null);
// Pets are kept per Copilot session (survives restarts and resumes), else per terminal.
const petKey = (me) => { try { return JSON.parse(readFileSync(join(DATA, "terminals", `${me}.json`), "utf8")).session_id || me; } catch { return me; } };
const renderPets = (force) => JSON.parse(run("node", [HELPER, "pets", ...(force ? ["--force"] : []), PETS, ...pets.petRoots(homedir(), DATA)]));
function usablePet(id) {
  const p = petIndex().find((x) => x.id === id);
  if (!p) fail(`no pet ${id}; see maestro pet ls`);
  if (p.error) fail(`pet ${id} failed to render: ${p.error}`);
  return p;
}
const worktrees = () => (existsSync(WORKTREES) ? JSON.parse(readFileSync(WORKTREES, "utf8")) : {});
const git = (cwd, args) => run("git", ["-C", cwd, ...args]).trim();

// kind "sibling": <parent of repo>/<repo>-<branch>. kind "herdr": Herdr's worktree mod
// convention, ~/.herdr/worktrees/<repo>/<branch>, shown as its own space nested under the repo's.
// A new branch starts from HEAD; an existing one is checked out.
function makeWorktree(from, branch, owner, kind = "sibling") {
  const top = git(from, ["rev-parse", "--show-toplevel"]);
  const repo = wt.repoOf(git(from, ["rev-parse", "--path-format=absolute", "--git-common-dir"]));
  const path = kind === "herdr" ? resolve(wt.herdrPath(homedir(), repo.name, branch)) : wt.siblingPath(top, branch);
  if (existsSync(path)) fail(`${path} already exists`);
  const exists = run("git", ["-C", top, "branch", "--list", branch]).trim();
  if (kind === "herdr") mkdirSync(dirname(path), { recursive: true });
  git(top, ["worktree", "add", ...(exists ? [path, branch] : ["-b", branch, path, ...(kind === "herdr" ? ["HEAD"] : [])])]);
  writeJson(WORKTREES, { ...worktrees(), [path]: { repo: top, branch, owner, kind, created: Date.now() } });
  return path;
}
const sharedConfig = () => { try { return JSON.parse(readFileSync(join(HOME, "shared.json"), "utf8")); } catch { return {}; } };

// Same canonical slug as the tag editor: lowercase [a-z0-9-], at most 24 characters.
const slug = (x) => String(x).toLowerCase().replace(/[^a-z0-9-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 24).replace(/-+$/, "");
const out = (v) => process.stdout.write(typeof v === "string" ? v + "\n" : JSON.stringify(v, null, 2) + "\n");
function fail(msg, code = 1) { process.stderr.write(`maestro: ${msg}\n`); process.exit(code); }
const run = (cmd, args) => execFileSync(cmd, args, { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
const json = (cmd, args) => JSON.parse(run(cmd, args));

function writeJson(path, value) {
  mkdirSync(join(path, ".."), { recursive: true });
  writeFileSync(path + ".tmp", JSON.stringify(value, null, 1));
  renameSync(path + ".tmp", path);
}
const recordOf = (t) => {
  const p = join(AGENTS, `${t}.json`);
  return existsSync(p) ? JSON.parse(readFileSync(p, "utf8")) : {};
};
const saveRecord = (t, patch) => writeJson(join(AGENTS, `${t}.json`), { ...recordOf(t), ...patch, updated: Date.now() });

function needMe() {
  if (!ME) fail("not inside a Herdr terminal (HC_TERMINAL_ID is unset)");
  return ME;
}

// Herdr's view: which space and tab each terminal is in, plus core state.
function world() {
  const app = json("herdr-app", ["ls"]);
  const where = new Map();
  for (const s of app.spaces ?? []) for (const tab of s.tabs ?? []) for (const term of tab.terminals ?? []) {
    where.set(term.terminal, { space: s.id, space_name: s.name, tab: tab.id, tab_name: tab.name, status: term.status ?? null, app: term.app ?? null });
  }
  // `hc ls` omits labels, which carry Maestro's lineage; read each terminal in full.
  const core = (json("hc", ["ls", "--json"]).terminals ?? []).map((t) => { try { return { ...t, ...json("hc", ["get", t.address, "--json"]) }; } catch { return t; } });
  const lineage = new Map(core.map((t) => {
    const rec = recordOf(t.address);
    const lab = t.labels ?? {};
    const parent = rec.parent ?? lab["maestro.parent"] ?? t.parent ?? null;
    return [t.address, { rec, lab, parent }];
  }));
  return core.map((t) => {
    const { rec, lab, parent } = lineage.get(t.address);
    const visited = new Set();
    let address = t.address;
    let w;
    while (address && !visited.has(address)) {
      visited.add(address);
      w = where.get(address);
      if (w) break;
      address = lineage.get(address)?.parent;
    }
    w ??= {};
    return { address: t.address, name: rec.name ?? lab["maestro.name"] ?? t.name ?? null, agent: t.agent ?? null, status: (typeof t.status === "object" ? t.status?.state : t.status) ?? w.status ?? null, cwd: t.cwd, space: w.space ?? null, space_name: w.space_name ?? null, tab_name: w.tab_name ?? null, parent, hc_parent: t.parent ?? null, tags: rec.tags ?? [], mood: rec.mood ?? null };
  });
}

const descendants = (all, root) => {
  const kids = new Set();
  let grew = true;
  while (grew) {
    grew = false;
    for (const t of all) if ((t.parent === root || kids.has(t.parent)) && !kids.has(t.address)) { kids.add(t.address); grew = true; }
  }
  return kids;
};

// A live terminal (address or Maestro name) this agent or its workers launched; anything else exits 3.
function ownTarget(target, verb) {
  const me = needMe();
  if (!target) fail(`usage: maestro ${verb} <terminal>`);
  const all = world();
  const t = all.find((x) => x.address === target || x.name === target);
  if (!t) fail(`no live terminal ${target}`);
  if (!descendants(all, me).has(t.address)) fail(`denied: ${t.address} was not launched by ${me} or its workers`, 3);
  return t;
}

function parseWait(args) {
  const o = { targets: [], mode: "any", timeout: null };
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === "--any" || a === "--all") o.mode = a.slice(2);
    else if (a === "--children") { const m = args[++i]; if (m !== "any" && m !== "all") fail("--children takes any or all"); o.mode = m; }
    else if (a === "--timeout") { o.timeout = Number(args[++i]); if (!(o.timeout > 0)) fail("--timeout takes seconds > 0"); }
    else if (a.startsWith("-")) fail(`unknown option ${a}; usage: maestro wait [<t>...] [--any|--all] [--timeout s]`);
    else o.targets.push(a);
  }
  return o;
}

// One `hc wait` as a cancellable promise: resolves with its JSON (or the error text).
function hcWait(args) {
  let child;
  const p = new Promise((done) => {
    child = execFile("hc", ["wait", ...args, "--json"], { encoding: "utf8" }, (err, stdout, stderr) => {
      if (err && err.killed) return done(null);
      try { done(JSON.parse(stdout)); } catch { done({ error: (stderr || err?.message || "hc wait failed").trim(), args }); }
    });
  });
  return { p, cancel: () => { try { child.kill(); } catch {} } };
}

// What finished, flattened: a children wait reports each child that stopped.
const finishedOf = (r) => (!r ? [] : r.error ? [r] : r.reason === "children" ? (r.children ?? []) : [r])
  .map((x) => (x.error ? x : { terminal: x.terminal, reason: x.reason, status: x.status ?? null, exit_code: x.exit_code ?? null, ...(x.signal != null ? { signal: x.signal } : {}) }));

// A pane-less worker: an hc child of this agent, shown as a sub-agent under it in Herdr and Maestro.
function spawnBg(me, opt, argv) {
  const hcName = opt.name ? opt.name.toLowerCase().replace(/[^a-z0-9_-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 32) : "";
  const labels = [`maestro.parent=${me}`, ...(opt.name ? [`maestro.name=${opt.name}`] : [])].flatMap((l) => ["--label", l]);
  const made = json("hc", ["run", "--bg", "--json", ...(hcName ? ["--name", hcName] : []), "--cwd", opt.cwd, ...labels, "--", ...argv]);
  if (!made.address) fail("hc run returned no terminal");
  saveRecord(made.address, { parent: me, name: opt.name ?? null, launched: Date.now(), launcher: me, worktree: opt.worktree ? opt.cwd : null, background: true, ...(opt.agent ? { agent: opt.agent } : {}) });
  if (opt.worktree) writeJson(WORKTREES, { ...worktrees(), [opt.cwd]: { ...worktrees()[opt.cwd], terminal: made.address } });
  out({ address: made.address, parent: me, background: true, ...(opt.agent ? { agent: opt.agent } : {}), ...(opt.worktree ? { worktree: opt.cwd } : {}) });
}

const commands = {
  whoami() {
    const me = needMe();
    const { hc_parent, ...self } = world().find((t) => t.address === me) ?? { address: me };
    out(self);
  },

  peers(args) {
    const me = needMe();
    const all = world();
    const self = all.find((t) => t.address === me);
    const scope = args.includes("--all") ? all : all.filter((t) => t.space && t.space === self?.space);
    out(scope.filter((t) => t.address !== me && t.agent).map(({ address, name, agent, status, space_name, tab_name, parent, tags, mood }) => ({ address, name, agent, status, space: space_name, tab: tab_name, parent, tags, mood })));
  },

  send([to, ...words]) {
    let target = to;
    const me = needMe();
    if (!target || !words.length) fail("usage: maestro send <terminal> <message>");
    const text = words.join(" ");
    let name = recordOf(me).name;
    if (!name) { try { name = json("hc", ["get", me, "--json"]).labels?.["maestro.name"]; } catch {} }
    name ??= me;
    const hit = world().find((t) => t.address === target || t.name === target);
    if (hit) target = hit.address;
    run("hc", ["send", target, `[maestro from ${me}${name !== me ? ` ${name}` : ""}] ${text}`]);
    out({ sent: true, to: target });
  },

  spawn(args) {
    const me = needMe();
    const opt = { name: null, cwd: process.cwd(), task: null, argv: null };
    for (let i = 0; i < args.length; i++) {
      const a = args[i];
      if (a === "--name") opt.name = args[++i];
      else if (a === "--cwd") opt.cwd = args[++i];
      else if (a === "--task") opt.task = args[++i];
      else if (a === "--worktree") opt.worktree = args[++i];
      else if (a === "--herdr-space" || a === "--sibling") opt.kindFlag = a;
      else if (a === "--bg") opt.bg = true;
      else if (a === "--agent") opt.agent = args[++i];
      else if (a === "--") { opt.argv = args.slice(i + 1); break; }
      else if (!opt.task) opt.task = a;
    }
    let agent = null;
    if (opt.agent) {
      if (opt.argv?.length) fail("use either --agent <name> or -- argv, not both");
      let sharedJson = null;
      try { sharedJson = JSON.parse(readFileSync(join(HOME, "shared.json"), "utf8")); } catch {}
      const { agents, cached } = agentlib.knownAgentsFrom(sharedJson);
      agent = agentlib.findAgent(opt.agent, agents);
      if (!agent) fail(`unknown agent ${opt.agent}; known: ${agents.map((x) => x.key).join(", ")}${cached ? "" : " (Maestro has not read Herdr's agent list yet; open the Maestro layout once)"}, or pass -- argv`);
      if (agent.installed === false) fail(`${agent.name ?? agent.key} is not installed on this machine (Herdr's agent list)`);
    }
    const plan = opt.argv?.length ? { argv: opt.argv, task: null } : agentlib.spawnPlan({ agent, task: opt.task, copilotArgv: DEFAULT_ARGV });
    if (opt.bg && plan.task) fail("background tasks for this agent need explicit argv; omit --bg to send the task through Herdr, or use -- argv");
    const kind = opt.worktree ? wt.chooseKind(opt.kindFlag ? [opt.kindFlag] : [], process.env, sharedConfig()) : null;
    if (opt.worktree) opt.cwd = makeWorktree(opt.cwd, opt.worktree, me, kind);
    const self = world().find((t) => t.address === me);
    const argv = ["node", HELPER, "run", ...plan.argv];
    if (opt.bg) return spawnBg(me, { ...opt, ...(agent ? { agent: agent.key } : {}) }, argv);
    const launch = { folder: opt.cwd, argv, ...(plan.task ? { task: plan.task } : {}) };
    // Herdr worktrees get their own space; sibling checkouts stay in the parent's space.
    const [verb, req] = kind === "herdr"
      ? ["space.new", { ...launch, ...(opt.name ? { tab: opt.name } : {}) }]
      : ["tab.new", { ...launch, ...(self?.space ? { space: self.space } : {}), ...(opt.name ? { name: opt.name } : {}) }];
    const made = JSON.parse(run("herdr-app", ["do", verb, JSON.stringify(req)]));
    if (made.error || !made.terminal) fail(`${verb} failed: ${made.error ?? "no terminal"}`);
    try { run("hc", ["label", made.terminal, `maestro.parent=${me}`, ...(opt.name ? [`maestro.name=${opt.name}`] : [])]); } catch {}
    saveRecord(made.terminal, { parent: me, name: opt.name ?? null, launched: Date.now(), launcher: me, worktree: opt.worktree ? opt.cwd : null, ...(agent ? { agent: agent.key } : {}) });
    if (opt.worktree) writeJson(WORKTREES, { ...worktrees(), [opt.cwd]: { ...worktrees()[opt.cwd], terminal: made.terminal, ...(kind === "herdr" ? { space: made.space } : {}) } });
    out({ address: made.terminal, tab: made.tab, space: made.space, parent: me, ...(agent ? { agent: agent.key } : {}), ...(opt.worktree ? { worktree: opt.cwd, kind } : {}) });
  },

  close([target]) {
    const me = needMe();
    if (!target) fail("usage: maestro close <terminal>");
    const all = world();
    const t = all.find((x) => x.address === target || x.name === target);
    if (!t) fail(`no live terminal ${target}`);
    if (!descendants(all, me).has(t.address)) fail(`denied: ${t.address} was not launched by ${me} or its workers`, 3);
    run("herdr-app", ["do", "terminal.kill", JSON.stringify({ terminal: t.address })]);
    out({ closed: t.address });
  },

  // Wait for this agent's workers (or the given terminals): --any returns at the first news, --all when none works.
  async wait(args) {
    const me = needMe();
    const o = parseWait(args);
    const extra = o.timeout ? ["--timeout", String(o.timeout)] : [];
    let waits = [];
    if (o.targets.length) {
      const all = world();
      const targets = o.targets.map((x) => {
        const t = all.find((y) => y.address === x || y.name === x);
        if (!t) fail(`no live terminal ${x}`);
        return t.address;
      });
      waits = targets.map((address) => hcWait([address, ...extra]));
    } else {
      // hc children (background workers) in one wait; tab workers are not hc children, so wait on each.
      const all = world();
      const tabKids = all.filter((t) => t.parent === me && t.hc_parent !== me);
      if (all.some((t) => t.hc_parent === me) || !tabKids.length) waits.push(hcWait(["--children", o.mode, ...extra]));
      for (const t of tabKids) waits.push(hcWait([t.address, ...extra]));
    }
    let results;
    if (o.mode === "all" || waits.length === 1) results = await Promise.all(waits.map((w) => w.p));
    else {
      results = [await Promise.race(waits.map((w) => w.p))];
      waits.forEach((w) => w.cancel());
    }
    const finished = results.flatMap(finishedOf);
    const reasons = [...new Set(results.filter(Boolean).map((r) => r.error ? "error" : r.reason))];
    out({ mode: o.mode, reason: reasons.length === 1 ? reasons[0] : reasons, finished });
  },

  // Stop a worker's current turn (not its process).
  interrupt([target]) {
    const t = ownTarget(target, "interrupt");
    out({ terminal: t.address, ...json("hc", ["interrupt", t.address, "--json"]) });
  },

  // Peek at any terminal over the tab (read-only view with keep-as-tab and close).
  peek([target]) {
    if (!target) fail("usage: maestro peek <terminal>");
    const t = world().find((x) => x.address === target || x.name === target);
    if (!t) fail(`no live terminal ${target}`);
    run("herdr-app", ["do", "terminal.peek", JSON.stringify({ terminal: t.address })]);
    out({ peek: t.address });
  },

  // Give a pane-less worker a pane (tab by default, or right/down).
  keep([target, ...flags]) {
    const pi = flags.indexOf("--place");
    const place = pi >= 0 ? flags[pi + 1] : null;
    if (place && !["tab", "right", "down"].includes(place)) fail("--place takes tab, right or down");
    const t = ownTarget(target, "keep");
    run("herdr-app", ["do", "terminal.keep", JSON.stringify({ terminal: t.address, ...(place ? { place } : {}) })]);
    out({ kept: t.address, place: place ?? "tab" });
  },

  // Remove a worker's pane; it keeps running as a pane-less sub-agent.
  park([target]) {
    const t = ownTarget(target, "park");
    run("herdr-app", ["do", "terminal.park", JSON.stringify({ terminal: t.address })]);
    out({ parked: t.address });
  },

  // Send a local file beside a terminal (on its machine); prints where it landed.
  put([target, file]) {
    if (!target || !file) fail("usage: maestro put <terminal> <file>");
    if (!existsSync(file)) fail(`${file} not found`);
    const t = world().find((x) => x.address === target || x.name === target);
    if (!t) fail(`no live terminal ${target}`);
    out({ terminal: t.address, ...json("hc", ["put", t.address, file, "--json"]) });
  },

  notify([title, ...body]) {
    const me = needMe();
    if (!title) fail("usage: maestro notify <title> [body]");
    const id = `${Date.now()}-${me}`;
    writeJson(join(NOTIFY, `${id}.json`), { from: me, title, body: body.join(" ") || null, at: Date.now() });
    out({ queued: id });
  },

  // Colors belong to the human (picked in the tag editor); agents only read them.
  tag([op, ...tags]) {
    const me = needMe();
    // Records written before slugs were enforced may hold raw tags; normalize them like the editor does.
    const cur = new Set((recordOf(me).tags ?? []).map(slug).filter(Boolean));
    const slugs = tags.flatMap((x) => x.split(",")).map(slug).filter(Boolean);
    if (op === "add") slugs.forEach((x) => cur.add(x));
    else if (op === "rm") slugs.forEach((x) => cur.delete(x));
    else if (op === "set") { cur.clear(); slugs.forEach((x) => cur.add(x)); }
    else if (op !== "ls") fail("usage: maestro tag add|rm|set|ls [tags...]");
    if (op !== "ls") { saveRecord(me, { tags: [...cur].slice(0, 8) }); out([...cur].slice(0, 8)); return; }
    let colors = {};
    try { colors = JSON.parse(readFileSync(join(HOME, "shared.json"), "utf8"))["maestro.tagColors"] ?? {}; } catch {}
    out([...cur].map((tag) => ({ tag, color: colors[tag] ?? null })));
  },

  mood([m]) {
    const me = needMe();
    if (!m) { out({ mood: recordOf(me).mood ?? null, choices: MOODS }); return; }
    if (m === "clear") { saveRecord(me, { mood: null }); out({ mood: null }); return; }
    if (!MOODS.includes(m)) fail(`mood must be one of: ${MOODS.join(", ")}`);
    saveRecord(me, { mood: m, mood_at: Date.now() });
    out({ mood: m });
  },

  // Why this session is (or is not) fully visible to Maestro.
  readiness() {
    const checks = [];
    const add = (ok, what, fix) => checks.push({ ok, what, ...(ok ? {} : { fix }) });
    add(Boolean(ME), "inside a Herdr terminal (HC_TERMINAL_ID)", "start Copilot from a Herdr tab or `maestro spawn`");
    let snap = null;
    if (ME) { try { snap = JSON.parse(readFileSync(join(DATA, "terminals", `${ME}.json`), "utf8")); } catch {} }
    add(Boolean(snap?.session_id), "status-line bridge reporting (session id, context, AIC)", "run scripts/install.sh, then restart this Copilot session");
    let settings = null;
    try { settings = JSON.parse(readFileSync(join(process.env.COPILOT_HOME ?? join(homedir(), ".copilot"), "settings.json"), "utf8")); } catch {}
    add(String(settings?.statusLine?.command ?? "").includes("maestro-statusline"), "Copilot statusLine points at maestro-statusline", "run scripts/install.sh");
    let mod = false;
    try { mod = existsSync(join(HOME, "mods", "maestro", "main.js")); } catch {}
    add(mod, "Maestro mod installed in Herdr", "run scripts/install.sh");
    out({ terminal: ME, session: snap?.session_id ?? null, ready: checks.every((c) => c.ok), checks });
  },

  // Worktrees Maestro created (sibling or Herdr kind): list them, or remove one when it is
  // clean and no live terminal (its worker or any other) is in it.
  worktree([op, target, ...flags]) {
    const all = worktrees();
    const liveTerms = () => json("hc", ["ls", "--json"]).terminals?.map((t) => ({ address: t.address, cwd: t.cwd })) ?? [];
    if (!op || op === "ls") {
      const live = new Set(liveTerms().map((t) => t.address));
      out(Object.entries(all).map(([path, w]) => ({ path, branch: w.branch, kind: wt.kindOf(w), owner: w.owner, terminal: w.terminal ?? null, live: w.terminal ? live.has(w.terminal) : false, ...(w.space ? { space: w.space } : {}) })));
      return;
    }
    if (op !== "rm" || !target) fail("usage: maestro worktree ls | rm <path|branch> [--force]");
    const entry = Object.entries(all).find(([p, w]) => p === target || w.branch === target);
    if (!entry) fail(`${target} is not a worktree Maestro created`, 3);
    const [path, w] = entry;
    const force = flags.includes("--force");
    const there = existsSync(path);
    const real = (p) => {
      try { return realpathSync(p); }
      catch (e) { if (e.code === "ENOENT" || e.code === "ENOTDIR") return p; throw e; }
    };
    const blocker = wt.removalBlocker({ path: real(path), displayPath: path, entry: w,
      live: liveTerms().map((t) => ({ ...t, cwd: t.cwd && real(t.cwd) })),
      dirty: there && Boolean(git(path, ["status", "--porcelain"])), force });
    if (blocker) fail(`denied: ${blocker}`, 3);
    if (wt.kindOf(w) === "herdr" && w.space) {
      // Its space usually went with its last tab; close it only when no terminal is left in it.
      try {
        const sp = (JSON.parse(run("herdr-app", ["ls"])).spaces ?? []).find((s) => s.id === w.space);
        if (sp && !(sp.tabs ?? []).some((tab) => (tab.terminals ?? []).length)) run("herdr-app", ["do", "space.close", JSON.stringify({ id: w.space, confirmed: true })]);
      } catch {}
    }
    if (there) git(w.repo, ["worktree", "remove", ...(force ? ["--force"] : []), path]);
    const next = { ...all };
    delete next[path];
    writeJson(WORKTREES, next);
    out({ removed: path, branch: w.branch, kind: wt.kindOf(w), note: "branch kept" });
  },

  // This agent's icon in Maestro: a preset name or one Nerd Font glyph, with an optional #rrggbb color.
  icon([glyph, color]) {
    const me = needMe();
    if (!glyph) { const r = recordOf(me); out({ icon: r.icon ?? null, color: r.color ?? null, presets: ICON_PRESETS }); return; }
    if (glyph === "clear") { saveRecord(me, { icon: null, color: null }); out({ icon: null }); return; }
    if (!ICON_PRESETS.includes(glyph) && [...glyph].length !== 1) fail(`icon must be one of ${ICON_PRESETS.join(", ")} or a single Nerd Font glyph`);
    if (color && !/^(#[0-9a-fA-F]{6}|ansi[1-6]|accent|working|blocked|done)$/.test(color)) fail("color must be a theme color (ansi1-ansi6, accent, working, blocked, done) or #rrggbb");
    saveRecord(me, { icon: glyph, color: color ?? recordOf(me).color ?? null });
    out({ icon: glyph, color: color ?? null });
  },

  // Pets: list, choose this session's or the default, add a sheet, re-render.
  pet([op = "ls", ...args]) {
    if (op === "ls") {
      const c = choices();
      const mine = ME ? pets.chosenPet(c, petKey(ME)) : null;
      out(petIndex().map((p) => ({ id: p.id, name: p.name, source: p.source ?? null, sheet: p.error ? null : p.moods ? "mood atlas" : "9-row",
        ...(p.error ? { error: p.error } : {}), ...(p.id === (c.default ?? pets.DEFAULT_PET) ? { default: true } : {}), ...(p.id === mine ? { mine: true } : {}) })));
      return;
    }
    if (op === "use") {
      const me = needMe(), key = petKey(me), [id] = args;
      if (!id) { const c = choices(); out({ session: key, pet: pets.resolvePet(petIndex(), pets.chosenPet(c, key))?.id ?? null, chosen: c.sessions[key] ?? null }); return; }
      if (id !== "clear") usablePet(id);
      writeJson(CHOICES, pets.setChoice(choices(), key, id === "clear" ? null : id));
      out({ session: key, pet: id === "clear" ? null : id });
      return;
    }
    if (op === "default") {
      const [id] = args;
      if (!id) { out({ default: choices().default ?? pets.DEFAULT_PET }); return; }
      usablePet(id);
      writeJson(CHOICES, pets.setChoice(choices(), null, id));
      out({ default: id });
      return;
    }
    if (op === "render") {
      const index = renderPets(args.includes("--force"));
      out({ pets: index.filter((p) => !p.error).length, failed: index.filter((p) => p.error).map(({ id, error }) => ({ id, error })) });
      return;
    }
    if (op === "add") {
      const src = args.find((a) => !a.startsWith("--"));
      if (!src) fail("usage: maestro pet add <pet folder | pet.json> [--link] [--force]");
      const abs = resolve(src);
      const manifest = abs.endsWith(".json") ? abs : join(abs, "pet.json");
      if (!existsSync(manifest)) fail(`${manifest} not found`);
      const m = JSON.parse(readFileSync(manifest, "utf8"));
      if (!m.id || !pets.ID_RE.test(m.id)) fail("pet.json needs an id of letters, digits, . _ -");
      const sheet = m.spritesheetPath ?? "spritesheet.webp";
      if (!existsSync(join(dirname(manifest), sheet))) fail(`sprite sheet ${sheet} not found next to pet.json`);
      const clash = petIndex().find((p) => p.id === m.id && p.source !== "added");
      if (clash) fail(`a ${clash.source ?? "other"} pet already uses id ${m.id}; give this one another id`);
      const dest = join(PET_SOURCES, m.id);
      if (resolve(dirname(manifest)).startsWith(resolve(PET_SOURCES))) fail(`${m.id} is already in ${PET_SOURCES}; use maestro pet render`);
      if (existsSync(dest)) { if (!args.includes("--force")) fail(`${m.id} was already added (use --force to replace)`); rmSync(dest, { recursive: true, force: true }); }
      mkdirSync(PET_SOURCES, { recursive: true });
      if (args.includes("--link")) symlinkSync(dirname(manifest), dest, process.platform === "win32" ? "junction" : "dir");
      else {
        mkdirSync(dirname(join(dest, sheet)), { recursive: true });
        copyFileSync(manifest, join(dest, "pet.json"));
        copyFileSync(join(dirname(manifest), sheet), join(dest, sheet));
      }
      const p = renderPets(false).find((x) => x.id === m.id);
      if (!p) fail(`added ${m.id}, but the renderer did not find it`);
      if (p.error) fail(`added ${m.id}, but it failed to render: ${p.error}`);
      out({ added: m.id, name: p.name, sheet: p.moods ? "mood atlas" : "9-row", path: dest });
      return;
    }
    fail("usage: maestro pet ls | use <id|clear> | default <id> | add <path> [--link] [--force] | render [--force]");
  },

  pin([v = "on"]) {
    const me = needMe();
    if (!["on", "off"].includes(v)) fail("usage: maestro pin [on|off]");
    let text;
    try { text = run("herdr-app", ["do", "terminal.pin", JSON.stringify({ terminal: me, pinned: v === "on" })]); } catch (e) { text = String(e.stdout ?? ""); if (!text.trim()) fail(`terminal.pin failed: ${e.message}`); }
    let r = null;
    try { r = JSON.parse(text || "null"); } catch {}
    if (r?.error) fail(`terminal.pin failed: ${r.error}`);
    out({ pinned: v === "on" });
  },

  name([n]) {
    const me = needMe();
    saveRecord(me, { name: n ?? null });
    out({ name: n ?? null });
  },

  help() {
    out(`maestro — coordinate Copilot agents in Herdr

  maestro whoami                       this terminal, its space, parent, tags, mood
  maestro peers [--all]                agents in this space (or everywhere)
  maestro send <t> <message>           message another agent (fire and forget)
  maestro spawn [--name n] [--cwd d] [--agent a] [--task text | -- argv...]
                                       open a visible worker (Copilot unless --agent claude, codex, …) in a new tab of this space
                 [--worktree <branch>]  … in a new sibling worktree <repo>-<branch>
                 [--herdr-space|--sibling]  … or Herdr's: ~/.herdr/worktrees/<repo>/<branch> in its own
                                       space nested under the repo's (default: MAESTRO_WORKTREE or
                                       shared maestro.worktreeKind = herdr|sibling, else sibling)
                 [--bg]                 … without a pane (a sub-agent under this one; peek or keep it)
  maestro close <t>                    close a worker this agent (or its workers) launched
  maestro wait [<t>...] [--any|--all] [--timeout s]
                                       wait for workers (default: this agent's) instead of polling
  maestro interrupt <t>                stop a worker's current turn (its own workers only)
  maestro peek <t>                     peek at a terminal over the tab
  maestro keep <t> [--place tab|right|down]
                                       give a pane-less worker a pane (its own workers only)
  maestro park <t>                     remove a worker's pane; it keeps running (its own workers only)
  maestro put <t> <file>               send a file beside a terminal; prints where it landed
  maestro worktree ls | rm <path|branch> [--force]
                                       worktrees Maestro created (kind sibling|herdr); rm only when
                                       clean and no live terminal is in it
  maestro notify <title> [body]        show the human a Herdr toast that jumps here
  maestro tag add|rm|set|ls [tags]     this agent's own tags
  maestro mood <${MOODS.join("|")}|clear>
  maestro name <short name>            label shown in Maestro
  maestro pin [on|off]                 pin this agent to the top of Herdr's and Maestro's lists
  maestro icon <preset|glyph> [color]   this agent's icon; color: theme name (ansi1-6, accent…) or #rrggbb (no argument lists presets; clear resets)
  maestro pet ls                       pets you can pick (mine/default marked)
  maestro pet use <id|clear>           this session's pet (kept across restarts and resumes)
  maestro pet default <id>             pet for sessions that have not picked one
  maestro pet add <folder|pet.json> [--link] [--force]
                                       add a Codex-format pet and render it
  maestro pet render [--force]         render new or changed sheets (all with --force)
  maestro readiness                    why this session is or is not fully visible to Maestro`);
  },
};

const [cmd = "help", ...rest] = process.argv.slice(2);
const fn = commands[cmd] ?? commands[cmd.replace(/^--?/, "")];
if (!fn) fail(`unknown command ${cmd}; see maestro help`);
try { await fn(rest); } catch (e) { fail(e.stderr?.toString().trim() || e.message); }
